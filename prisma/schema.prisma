generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Coleta {
  id          String        @id @default(cuid())
  nome        String
  telefone    String
  material    String
  horario     String
  endereco    String
  cidade      String?
  estado      String?
  status      StatusColeta  @default(PENDENTE)
  cooperativaId String?
  criadoEm    DateTime      @default(now())
  atualizadoEm DateTime     @updatedAt
  cooperativa Cooperativa? @relation(fields: [cooperativaId], references: [id], onDelete: SetNull)

  @@index([cooperativaId])
}

model Cooperativa {
  id         String   @id @default(cuid())
  authUserId String   @unique
  email      String?  @unique
  nome       String
  criadoEm   DateTime @default(now())
  coletas    Coleta[]
}

model CooperativaConvite {
  id        String   @id @default(cuid())
  email     String   @unique
  tokenHash String   @unique
  criadoEm  DateTime @default(now())
  expiraEm  DateTime
  usadoEm   DateTime?
}

model PontoColeta {
  id       String @id @default(cuid())
  nome     String
  endereco String
  cidade   String
  estado   String
  telefone String?
  latitude Float
  longitude Float
  criadoEm DateTime @default(now())
}

enum StatusColeta {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}